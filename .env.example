# Sendblue credentials (from https://dashboard.sendblue.com)
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=+15551234567
SENDBLUE_GLOBAL_WEBHOOK_SECRET=
# Public receive URL (cloudflared / ngrok). Auto-registered on agent start if missing.
# SENDBLUE_WEBHOOK_URL=https://xxxx.trycloudflare.com/webhooks/receive

# llama.cpp OpenAI-compatible server
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_MODEL=local
# GGUF for ./run.sh (-hf). Gemma 12B UD-Q4_K_XL (~7.4 GB) fits M4 24 GB + other apps.
# Muse 30B UD-Q4_K_XL (~15.9 GB) needs ~17 GB+ / Mac 32 GB.
LLAMA_HF_REPO=unsloth/gemma-4-12b-it-GGUF:UD-Q4_K_XL
# Download cache (default: LLAMA_HF_REPO without :quant → <project>/.cache/…)
# LLAMA_CACHE=unsloth/gemma-4-12b-it-GGUF
# Memory-conscious llama-server knobs (Gemma 12B on M4 24 GB + desktop apps):
LLAMA_CACHE_RAM=1024
LLAMA_CTX_SIZE=16384
LLAMA_PARALLEL=1
LLAMA_THREADS=8
LLAMA_BATCH=1024
LLAMA_UBATCH=256
LLAMA_N_GPU_LAYERS=99
LLAMA_FIT_TARGET=4096
# LLAMA_PORT=8080
# AGENT_HOST=0.0.0.0
# AGENT_PORT=8000

# Optional comma-separated E.164 allowlist (empty = allow all)
ALLOWED_NUMBERS=

# Agent behavior
MAX_HISTORY_MESSAGES=40
MAX_AGENT_ITERATIONS=5
MAX_EXECUTOR_ITERATIONS=8

# Durable conversation history, semantic memory, and Markdown skills
MEMORY_ENABLED=true
DATABASE_PATH=.data/baka.db
MEMORY_CONSOLIDATION_ENABLED=true
MEMORY_SUMMARY_EVERY_TURNS=20
SKILLS_DIR=skills
MEMORY_MAX_CHARS=3000
SKILL_MAX_CHARS=5000

# llama.cpp embedding sidecar used by hybrid FTS5/vector retrieval
EMBEDDING_ENABLED=true
EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
EMBEDDING_MODEL=local-embedding
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=10
EMBEDDING_HF_REPO=nomic-ai/nomic-embed-text-v1.5-GGUF:F16
# EMBEDDING_PORT=8081

# MCP (Cursor-compatible mcp.json; copy mcp.json.example → mcp.json)
MCP_ENABLED=true
MCP_CONFIG_PATH=mcp.json
# Persisted OAuth tokens for remote MCP servers (SnapTrade, etc.)
MCP_OAUTH_DATA_DIR=.data/mcp-oauth
# Phone that owns SnapTrade OAuth tokens (defaults to sole ALLOWED_NUMBERS entry)
MCP_OAUTH_OWNER_NUMBER=

# Home Assistant credentials
HOME_ASSISTANT_API_KEY=