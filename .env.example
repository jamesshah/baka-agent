# Sendblue credentials (from https://dashboard.sendblue.com)
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=+15551234567
SENDBLUE_GLOBAL_WEBHOOK_SECRET=
# Public receive URL (cloudflared / ngrok). Auto-registered on agent start if missing.
# SENDBLUE_WEBHOOK_URL=https://xxxx.trycloudflare.com/webhooks/receive

# llama.cpp OpenAI-compatible server
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
LLAMA_MODEL=local

# Optional comma-separated E.164 allowlist (empty = allow all)
ALLOWED_NUMBERS=

# Agent behavior
MAX_HISTORY_MESSAGES=40
MAX_AGENT_ITERATIONS=5

# MCP (Cursor-compatible mcp.json; copy mcp.json.example → mcp.json)
MCP_ENABLED=true
MCP_CONFIG_PATH=mcp.json
# Persisted OAuth tokens for remote MCP servers (SnapTrade, etc.)
MCP_OAUTH_DATA_DIR=.data/mcp-oauth
# Phone that owns SnapTrade OAuth tokens (defaults to sole ALLOWED_NUMBERS entry)
MCP_OAUTH_OWNER_NUMBER=

# Home Assistant credentials
HOME_ASSISTANT_API_KEY=