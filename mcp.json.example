{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    },
    "snaptrade": {
      "url": "https://mcp.snaptrade.com/mcp",
      "auth": "oauth",
      "scopes": ["read"]
    },
    "optional-remote": {
      "enabled": false,
      "url": "https://example.com/mcp"
    }
  }
}
